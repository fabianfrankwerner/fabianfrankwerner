    {
      "parameters": {
        "jsCode": "const raw = $input.all()[0].json.content?.parts?.[0]?.text || '{}';\nconst cleanRaw = raw.replace(/^```json\\s*/i, '').replace(/```\\s*$/, '').trim();\nconst parsed = JSON.parse(cleanRaw);\n\nconst fallbackNotionPageId = 'YOUR_FALLBACK_PAGE_ID_HERE';\nlet finalPageId = parsed.notion_page_id;\nlet finalPageTitle = parsed.notion_page_title;\nlet usedFallback = false;\n\nif (!finalPageId || finalPageId === 'null') {\n  finalPageId = fallbackNotionPageId;\n  finalPageTitle = \"General Changelog\";\n  usedFallback = true;\n}\n\nlet slackMsg = parsed.slackMessage || '';\nif (usedFallback) {\n  slackMsg += '\\n\\n_Note: Could not find a specific feature page. Appended to general Changelog._';\n}\n\nreturn [{\n  json: {\n    notion_page_id: finalPageId,\n    notion_page_title: finalPageTitle,\n    features: parsed.features || [],\n    bug_fixes: parsed.bug_fixes || [],\n    slackMessage: slackMsg\n  }\n}];"
      },
