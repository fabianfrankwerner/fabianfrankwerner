        "messages": {
          "values": [
            {
              "content": "=You are a product communication expert. Generate role-specific communication drafts from this product update.\n\nTitle: {{ $('Webhook').item.json.body.title }}\nWhat was built: {{ $('Webhook').item.json.body.what_was_built }}\nWhat users can now do: {{ $('Webhook').item.json.body.what_users_can_do }}\nWhat changes for existing users: {{ $('Webhook').item.json.body.what_changes }}\nPrimary audience: {{ $('Webhook').item.json.body.audience }}\nSubmitted by: {{ $('Webhook').item.json.body.submitted_by }}\n\nReturn ONLY this JSON, nothing else, no backticks, no explanation:\n{\n  \"sales_text\": \"2-3 sentences focused on customer value and competitive advantage\",\n  \"cs_text\": \"2-3 sentences focused on helping existing customers succeed with this change\",\n  \"cartoon_script\": \"Panel 1: [scene] - [dialogue]. Panel 2: [scene] - [dialogue]. Panel 3: [scene] - [dialogue]. Panel 4: [scene] - [dialogue].\",\n  \"slack_message\": \"Short Slack message under 100 words with emojis\"\n}"
            }
          ]
        },
        "options": {}
      },
