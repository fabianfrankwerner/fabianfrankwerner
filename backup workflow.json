    {
      "parameters": {
        "jsCode": "const localWorkflows = $('Remove n8n Duplicates').all().map(item => item.json);\nconst githubFiles = $('Remove GitHub Duplicates').all().map(item => item.json);\n\nconst actions = [];\n\nlocalWorkflows.forEach(workflow => {\n  const filename = `${workflow.name}.json`.toLowerCase();\n  const githubFile = githubFiles.find(f => f.name === filename);\n  const fileContent = JSON.stringify(workflow, null, 2);\n\n  if (!githubFile) {\n    actions.push({\n      action: 'create',\n      filename: filename,\n      content: fileContent\n    });\n  } else {\n    actions.push({\n      action: 'update',\n      filename: filename,\n      content: fileContent,\n      sha: githubFile.sha\n    });\n  }\n});\n\ngithubFiles.forEach(file => {\n  const existsLocally = localWorkflows.some(w => `${w.name}.json`.toLowerCase() === file.name);\n  \n  if (!existsLocally) {\n    actions.push({\n      action: 'delete',\n      filename: file.name,\n      sha: file.sha\n    });\n  }\n});\n\nreturn actions.map(action => ({ json: action }));"
      },
