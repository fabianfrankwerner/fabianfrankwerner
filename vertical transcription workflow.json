    {
      "parameters": {
        "jsCode": "const rawInput = $input.first().json.chatInput;\nconst urlRegex = /(https?:\\/\\/[^\\s]+)/g;\nconst matches = rawInput.match(urlRegex);\n\nif (!matches || matches.length === 0) {\n    throw new Error(\"No valid URLs detected.\");\n}\n\nconst supportedPlatforms = ['instagram', 'tiktok', 'youtube'];\nconst results = [];\n\nfor (let rawUrl of matches) {\n    let cleanUrl = rawUrl.replace(/[^a-zA-Z0-9]+$/, '');\n  \n    try {\n        const urlObj = new URL(cleanUrl);\n        urlObj.search = \"\";\n        cleanUrl = urlObj.toString();\n    } catch (e) {\n        cleanUrl = cleanUrl.split('?')[0];\n    }\n    \n    if (cleanUrl.endsWith('/')) {\n        cleanUrl = cleanUrl.slice(0, -1);\n    }\n\n    const isSupported = supportedPlatforms.some(platform => cleanUrl.toLowerCase().includes(platform));\n    if (isSupported) {\n        results.push({ json: { url: cleanUrl } });\n    }\n}\n\nif (results.length === 0) {\n    throw new Error(\"No supported platform URLs detected.\");\n}\n\nreturn results;"
      },
