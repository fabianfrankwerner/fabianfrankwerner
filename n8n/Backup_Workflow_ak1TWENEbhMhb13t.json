    {
      "parameters": {
        "jsCode": "const workflows = $('Remove Duplicates').all();\n\nconst commitData = $('Get commit').first().json;\nconst baseCommitSha = commitData.sha;\nconst baseTreeSha = commitData.tree.sha;\n\nconst existingGitTree = $('Get tree').first().json.tree || [];\n\nconst activePaths = new Set();\n\nconst tree = workflows.map((item) => {\n  const wf = item.json;\n  const safeName = (wf.name || 'Untitled_Workflow')\n    .replace(/[^a-zA-Z0-9_\\-\\s]/g, '')\n    .trim()\n    .replace(/\\s+/g, '_');\n\n  const filePath = `n8n/${safeName}_${wf.id}.json`;\n  activePaths.add(filePath);\n\n  return {\n    path: filePath,\n    mode: '100644',\n    type: 'blob',\n    content: JSON.stringify(wf, null, 2),\n  };\n});\n\nfor (const item of existingGitTree) {\n  if (item.path.startsWith('n8n/') && item.type === 'blob' && !activePaths.has(item.path)) {\n    tree.push({\n      path: item.path,\n      mode: '100644',\n      type: 'blob',\n      sha: null,\n    });\n  }\n}\n\nreturn [{\n  json: {\n    base_tree: baseTreeSha,\n    parent_commit_sha: baseCommitSha,\n    tree: tree,\n  }\n}];"
      },
