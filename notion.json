    {
      "parameters": {
        "jsCode": "const rawInput = typeof item === 'object' && item.json ? item.json.chatInput : $json.chatInput;\n\nif (!rawInput) {\n    throw new Error(\"No input received from the chat trigger.\");\n}\n\nconst urlRegex = /(https?:\\/\\/[^\\s]+)/g;\nconst match = rawInput.match(urlRegex);\n\nif (!match) {\n    throw new Error(\"No valid URL detected.\");\n}\n\nlet cleanUrl = match[0];\n\ntry {\n    const urlObj = new URL(cleanUrl);\n    urlObj.search = \"\";\n    cleanUrl = urlObj.toString();\n    \n    if (cleanUrl.endsWith('/')) {\n        cleanUrl = cleanUrl.slice(0, -1);\n    }\n} catch (e) {\n    cleanUrl = cleanUrl.split('?')[0];\n    if (cleanUrl.endsWith('/')) {\n        cleanUrl = cleanUrl.slice(0, -1);\n    }\n}\n\nreturn [{ json: { url: cleanUrl } }];"
      },
